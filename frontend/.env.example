# ─── Environment: local | development | production ─────────────────────────
# Copy this to .env.local for local development

NEXT_PUBLIC_APP_ENV=local

# API
# BACKEND_URL is server-side only — used by Next.js rewrites proxy to forward /api/v1/* requests.
# Browser requests hit /api/v1/* (same-origin), Next.js forwards them to BACKEND_URL.
# In Docker set BACKEND_URL=http://backend:8000 (service name on the Docker network).
BACKEND_URL=http://localhost:8001
# Leave NEXT_PUBLIC_API_URL unset to use the proxy. Set it only to bypass the proxy entirely.
# NEXT_PUBLIC_API_URL=

# Logto Authentication
NEXT_PUBLIC_LOGTO_ENDPOINT=http://localhost:3001
NEXT_PUBLIC_LOGTO_APP_ID=your-app-id
LOGTO_APP_SECRET=your-app-secret
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32

# MSW (Mock Service Worker) - enable only when running without backend
NEXT_PUBLIC_MOCK_API=false

# Feature flags
NEXT_PUBLIC_FF_MAINTENANCE=false
NEXT_PUBLIC_FF_ANALYTICS=true
