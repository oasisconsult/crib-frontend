# ─── Crib — Production Environment ──────────────────────────────────────────
# Copy this file to .env.production in the repo root on the VPS and fill in
# REAL values.  Never commit .env.production to git.
#
# IMPORTANT: put LITERAL values here — no ${VAR} interpolation.
# Docker Compose expands ${} references against the host shell environment;
# if those vars aren't exported there, the service starts with blank secrets.
#
# Variable names must match exactly what docker-compose.prod.shared.yml
# references with ${...}.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres (shared GeoBox instance) ────────────────────────────────────────
DB_USER=crib
DB_PASSWORD=your_db_password_here
DB_HOST=geobox-postgres-prod       # container name on geobox-network
DB_PORT=5432
DB_NAME=crib_prod

# ── Redis (shared GeoBox instance — Crib uses DB 6) ──────────────────────────
REDIS_PASSWORD=your_redis_password_here
REDIS_HOST=geobox-redis-prod        # container name on geobox-network
REDIS_PORT=6379
REDIS_DB=6

# ── Logto (shared GeoBox instance) ───────────────────────────────────────────
# Public URL — used as OIDC issuer in JWT validation AND baked into the
# Next.js bundle as NEXT_PUBLIC_LOGTO_ENDPOINT.
LOGTO_PUBLIC_ENDPOINT=https://auth.geoboxafrica.com

# Server-side endpoint — internal Docker hostname (avoids hairpin NAT).
LOGTO_ENDPOINT=http://geobox-logto-prod:3001

# Logto Admin API endpoint
LOGTO_ADMIN_ENDPOINT=http://geobox-logto-prod:3002

# Override for JWKS fetch (internal Docker hostname so backend doesn't go
# out to the internet to validate JWTs)
LOGTO_JWKS_URI_OVERRIDE=http://geobox-logto-prod:3001/oidc/jwks

# Crib "Traditional Web" application credentials (created in Logto Admin)
LOGTO_APP_ID=your_logto_app_id_here
LOGTO_APP_SECRET=your_logto_app_secret_here

# Crib M2M application credentials (for backend → Logto API calls)
LOGTO_M2M_APP_ID=your_m2m_app_id_here
LOGTO_M2M_APP_SECRET=your_m2m_app_secret_here

# Logto API resource (audience) registered for Crib
LOGTO_API_RESOURCE=https://crib.geoboxafrica.com/api

# Logto Management API resource (for org/user management calls)
LOGTO_ADMIN_API_RESOURCE=https://auth.geoboxafrica.com/api

# ── MinIO / S3 object storage ─────────────────────────────────────────────────
MINIO_ENDPOINT=minio.geoboxafrica.com   # or internal hostname
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET=crib-prod
MINIO_SECURE=true

# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=your_long_random_secret_key_here   # min 32 chars, e.g. openssl rand -hex 32
FRONTEND_URL=https://crib.geoboxafrica.com
CORS_ORIGINS=https://crib.geoboxafrica.com
