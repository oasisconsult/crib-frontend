# =============================================================================
# Crib Backend — Development Dockerfile (Poetry, hot-reload)
# =============================================================================
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    POETRY_VERSION=1.8.4 \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_CACHE_DIR=/tmp/poetry-cache

# System deps: WeasyPrint + git (git needed to redirect geobox-rbac clone below)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libffi-dev \
    libcairo2 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir poetry==$POETRY_VERSION

WORKDIR /app

# geobox-rbac local copy — must arrive before pyproject.toml so the git
# insteadOf redirect below works without hitting GitHub.
# vendor/ is populated by `make clone-deps` before docker compose build.
COPY vendor/geobox-rbac ./vendor/geobox-rbac

# Redirect any git clone of the GitHub URL to our local copy.
# Poetry uses git clone internally for git deps; this makes it use the
# local vendor copy instead of authenticating to a private GitHub repo.
RUN git config --global \
    url."file:///app/vendor/geobox-rbac".insteadOf \
    "https://github.com/oasisconsult/geobox-rbac.git"

# Install all deps
COPY pyproject.toml poetry.lock* ./
RUN poetry install --no-root && rm -rf $POETRY_CACHE_DIR

# Source is mounted as a volume at runtime (hot-reload)
EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
