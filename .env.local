# ─── Local environment (developer machine) ───────────────────────────────────
# Used by: docker-compose.local.yml
# Copy to .env.local and fill in values. NEVER commit this file.

APP_NAME=Crib
ENVIRONMENT=development

# PostgreSQL (backend)
POSTGRES_USER=cribuser
POSTGRES_PASSWORD=cribpass
POSTGRES_DB=crib

# Redis
REDIS_PASSWORD=redispass

# Logto Postgres (separate DB for Logto auth service)
LOGTO_POSTGRES_USER=logtouser
LOGTO_POSTGRES_PASSWORD=logtopass
LOGTO_POSTGRES_DB=logto

# Logto (Auth)
NEXT_PUBLIC_LOGTO_ENDPOINT=http://localhost:3011
LOGTO_ADMIN_ENDPOINT=http://localhost:3012
NEXT_PUBLIC_LOGTO_APP_ID=your-local-app-id
LOGTO_APP_SECRET=your-local-app-secret

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXTAUTH_SECRET=f687985d646a2e01d2ed35748e835b290d1cb1297a73e8869f01445b7d2a303d
NEXT_PUBLIC_MSW_ENABLED=true

# Backend
SECRET_KEY=f687985d646a2e01d2ed35748e835b290d1cb1297a73e8869f01445b7d2a303d

# MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=f687985d646a2e01d2ed35748e835b290d1cb1297a73e8869f01445b7d2a303d
MINIO_BUCKET=crib-local

# Notifications (optional for local)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
