# ─── Local environment (developer machine) ───────────────────────────────────
# Used by: docker-compose.local.yml
# Copy to .env.local and fill in values. NEVER commit this file.

APP_NAME=Crib
ENVIRONMENT=local

# PostgreSQL
POSTGRES_USER=crib
POSTGRES_PASSWORD=crib_local_secret
POSTGRES_DB=crib_local

# Redis
REDIS_PASSWORD=redis_local_secret

# Logto (Auth)
NEXT_PUBLIC_LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002
NEXT_PUBLIC_LOGTO_APP_ID=your-local-app-id
LOGTO_APP_SECRET=your-local-app-secret
LOGTO_POSTGRES_USER=logto
LOGTO_POSTGRES_PASSWORD=logto_local_secret
LOGTO_POSTGRES_DB=logto

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_SECRET=local-secret-change-me-openssl-rand-hex-32
NEXT_PUBLIC_MSW_ENABLED=true

# Backend
SECRET_KEY=local-backend-secret-change-me

# MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_local
MINIO_BUCKET=crib-local

# Notifications (optional for local)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
