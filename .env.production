# ─── Production environment ───────────────────────────────────────────────────
# Used by: docker-compose.yml
# All values must come from a secrets manager (Vault, AWS Secrets Manager, etc.)
# Never store real secrets in this file.

APP_NAME=Crib
ENVIRONMENT=production

POSTGRES_USER=crib
POSTGRES_PASSWORD=${PROD_POSTGRES_PASSWORD}
POSTGRES_DB=crib

REDIS_PASSWORD=${PROD_REDIS_PASSWORD}

NEXT_PUBLIC_LOGTO_ENDPOINT=https://auth.crib.app
LOGTO_ADMIN_ENDPOINT=https://auth-admin.crib.app
NEXT_PUBLIC_LOGTO_APP_ID=${PROD_LOGTO_APP_ID}
LOGTO_APP_SECRET=${PROD_LOGTO_APP_SECRET}
LOGTO_POSTGRES_USER=logto
LOGTO_POSTGRES_PASSWORD=${PROD_LOGTO_POSTGRES_PASSWORD}
LOGTO_POSTGRES_DB=logto

NEXT_PUBLIC_API_URL=https://api.crib.app
NEXTAUTH_SECRET=${PROD_NEXTAUTH_SECRET}
NEXT_PUBLIC_MSW_ENABLED=false

SECRET_KEY=${PROD_SECRET_KEY}

MINIO_ACCESS_KEY=${PROD_MINIO_ACCESS_KEY}
MINIO_SECRET_KEY=${PROD_MINIO_SECRET_KEY}
MINIO_BUCKET=crib-documents

SENDGRID_API_KEY=${PROD_SENDGRID_API_KEY}
TWILIO_ACCOUNT_SID=${PROD_TWILIO_ACCOUNT_SID}
TWILIO_AUTH_TOKEN=${PROD_TWILIO_AUTH_TOKEN}
TWILIO_FROM_NUMBER=${PROD_TWILIO_FROM_NUMBER}
WHATSAPP_API_KEY=${PROD_WHATSAPP_API_KEY}
WHATSAPP_PHONE_ID=${PROD_WHATSAPP_PHONE_ID}
