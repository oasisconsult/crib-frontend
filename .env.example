# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Crib
ENVIRONMENT=development

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_SECRET=change-me-in-production-use-openssl-rand-hex-32

# ─── Logto — Frontend ─────────────────────────────────────────────────────────
NEXT_PUBLIC_LOGTO_ENDPOINT=http://localhost:3001
NEXT_PUBLIC_LOGTO_APP_ID=your-frontend-logto-app-id

# ─── Logto — Backend (inside Docker, use service name not localhost) ───────────
# LOGTO_ENDPOINT and LOGTO_ADMIN_ENDPOINT use the Docker service name "logto"
# so the backend container can reach Logto on the internal network.
LOGTO_ENDPOINT=http://logto:3001/
LOGTO_APP_ID=your-backend-logto-app-id
LOGTO_APP_SECRET=your-logto-app-secret
LOGTO_ADMIN_ENDPOINT=http://logto:3002/
LOGTO_POSTGRES_USER=logto
LOGTO_POSTGRES_PASSWORD=change-me
LOGTO_POSTGRES_DB=logto

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=crib
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crib_dev

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me

# ─── MinIO (S3-compatible storage) ────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-min-8-chars
MINIO_BUCKET=crib-documents

# ─── Backend ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Logto backend vars
LOGTO_ENDPOINT=http://localhost:3001/
LOGTO_APP_ID=your-logto-backend-app-id
LOGTO_APP_SECRET=your-logto-backend-app-secret
LOGTO_API_RESOURCE=http://localhost:8001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002/
# Optional: M2M app for organisation provisioning
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=

# Notification channel selection
SMS_PROVIDER=twilio
EMAIL_PROVIDER=sendgrid
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=

# ─── Notifications ────────────────────────────────────────────────────────────
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Dev Only ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MSW_ENABLED=true
