# ─────────────────────────────────────────────────────────────────────────────
# Crib — Production Environment Variables
# Copy this file to .env.production and fill in the values.
# Run: openssl rand -base64 48 | tr -d '\n/+=' to generate strong passwords.
#
# WARNING: Never commit .env.production to git — it contains secrets.
# Store all passwords in a secure password manager (e.g. 1Password, Bitwarden).
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<GENERATE_STRONG_KEY>
# Used to encrypt org-level settings (payment keys, SMS credentials) stored in DB.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: Changing this key makes all previously-encrypted settings unreadable.
SETTINGS_ENCRYPTION_KEY=<GENERATE_FERNET_KEY>
# Used by Logto Next SDK (cookieSecret) to encrypt session cookies
# Generate: openssl rand -base64 32 | tr -d '\n/+='
NEXTAUTH_SECRET=<GENERATE_STRONG_KEY>
FRONTEND_URL=https://crib.yourdomain.com
CORS_ORIGINS=https://crib.yourdomain.com

# ── Database (shared geobox-db-prod) ─────────────────────────────────────────
# Database and user are created by GeoBox postgres/init/01-init-dbs.sql
# Host is the GeoBox Postgres container name — reachable via geobox-network
DB_HOST=geobox-db-prod
DB_PORT=5432
DB_NAME=crib
DB_USER=crib_user
# Generate: openssl rand -base64 32 | tr -d '\n/+='
# MUST match CRIB_DB_PASSWORD in GeoBox's .env.production
DB_PASSWORD=<GENERATE_STRONG_PASSWORD>

# ── Redis (shared geobox-redis-prod) ─────────────────────────────────────────
# GeoBox Redis DB allocation — DO NOT use these:
#   DB 0  GeoBox API (main)     DB 4  GeoBox billing
#   DB 1  GeoBox sessions       DB 5  GeoBox (other)
#   DB 2  GeoBox rate-limit     DB 7  GeoBox (workers)
#   DB 3  GeoBox security
# Crib uses DB 6. FixLeakage uses DB 8.
REDIS_HOST=geobox-redis-prod
REDIS_PORT=6379
REDIS_DB=6
# Same password configured on the GeoBox Redis container (requirepass)
REDIS_PASSWORD=<GEOBOX_REDIS_PASSWORD>

# ── RBAC (shared rbac DB — same Postgres server as Crib) ─────────────────────
# Phase 4: DB-authoritative roles. Must point to the shared rbac database.
# Format: postgresql+asyncpg://user:pass@host/rbac
# DB_USER/DB_PASSWORD/DB_HOST above are reused here (same Postgres server).
# This is evaluated in docker-compose.prod.shared.yml — no need to duplicate.
# If you ever override: RBAC_DATABASE_URL=postgresql+asyncpg://<user>:<pass>@<host>/rbac

# ── Logto (shared geobox-logto-prod) ─────────────────────────────────────────
# Public URL — must match what the browser reaches (set in Nginx Proxy Manager)
LOGTO_PUBLIC_ENDPOINT=https://auth.yourdomain.com   # browser-reachable (baked into frontend bundle)
LOGTO_ENDPOINT=https://auth.yourdomain.com          # same as above for backend JWT validation
# Internal Docker hostname — avoids going through Nginx for JWKS fetch
LOGTO_JWKS_URI_OVERRIDE=http://geobox-logto-prod:3001/oidc/jwks
# Logto admin API — internal Docker hostname, never exposed publicly
LOGTO_ADMIN_ENDPOINT=http://geobox-logto-prod:3002
# Crib Application in Logto (Applications → Traditional Web → create new)
LOGTO_APP_ID=<FROM_LOGTO_ADMIN>
LOGTO_APP_SECRET=<FROM_LOGTO_ADMIN>
# Crib M2M Application in Logto (for backend→Management API calls)
LOGTO_M2M_APP_ID=<FROM_LOGTO_ADMIN>
LOGTO_M2M_APP_SECRET=<FROM_LOGTO_ADMIN>
# API Resource identifier registered in Logto for Crib
LOGTO_API_RESOURCE=https://crib.yourdomain.com/api
# Logto Management API resource identifier — for self-hosted Logto this is
# the public Logto URL + /api. Find it in Logto Admin → API Resources → Logto Management API
LOGTO_ADMIN_API_RESOURCE=https://auth.yourdomain.com/api

# ── MinIO / S3 object storage ─────────────────────────────────────────────────
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=<minio-host>:9000
MINIO_ACCESS_KEY=<FROM_MINIO_ADMIN>
MINIO_SECRET_KEY=<FROM_MINIO_ADMIN>
MINIO_BUCKET=crib-prod
MINIO_SECURE=true

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=<FROM_SENDGRID>
EMAIL_FROM=noreply@yourdomain.com
