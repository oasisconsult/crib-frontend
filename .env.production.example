# ─────────────────────────────────────────────────────────────────────────────
# Crib — Production Environment Variables
# Copy this file to .env.production and fill in the values.
# Never commit .env.production to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_hex(32))">
FRONTEND_URL=https://crib.yourdomain.com
CORS_ORIGINS=https://crib.yourdomain.com

# ── Database (shared geobox-db-prod, dedicated Crib database) ────────────────
# The hostname is the GeoBox Postgres container name — reachable via geobox-network
DATABASE_URL=postgresql+asyncpg://crib:<password>@geobox-db-prod:5432/crib_prod

# ── Redis (shared geobox-redis-prod, DB index 1 to avoid GeoBox collisions) ──
REDIS_URL=redis://:<password>@geobox-redis-prod:6379/1
REDIS_PASSWORD=<same password as GeoBox redis requirepass>

# ── Logto (shared geobox-logto-prod) ─────────────────────────────────────────
# Public URL — what the browser navigates to (set in Nginx Proxy Manager)
LOGTO_ENDPOINT=https://auth.yourdomain.com
# Internal Docker URL for JWKS fetch (avoids going out through Nginx)
LOGTO_JWKS_URI_OVERRIDE=http://geobox-logto-prod:3001/oidc/jwks
# Logto admin API (server-side only, never exposed to browser)
LOGTO_ADMIN_ENDPOINT=http://geobox-logto-prod:3002
# Crib's own Application in Logto (create under Applications → Traditional Web)
LOGTO_APP_ID=<from Logto admin>
LOGTO_APP_SECRET=<from Logto admin>
# Crib's M2M Application in Logto (for backend→Logto Management API calls)
LOGTO_M2M_APP_ID=<from Logto admin>
LOGTO_M2M_APP_SECRET=<from Logto admin>
# API Resource identifier registered in Logto for Crib
LOGTO_API_RESOURCE=https://crib.yourdomain.com/api

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
# Use shared MinIO if GeoBox has one, otherwise point to Cloudflare R2 / AWS S3
MINIO_ENDPOINT=minio.yourdomain.com:9000
MINIO_ACCESS_KEY=<access key>
MINIO_SECRET_KEY=<secret key>
MINIO_BUCKET=crib-prod
MINIO_SECURE=true

# ── Email (SendGrid or SMTP) ──────────────────────────────────────────────────
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=<key>
EMAIL_FROM=noreply@yourdomain.com

# ── Postgres credentials (used by alembic, not the app directly) ─────────────
POSTGRES_USER=crib
POSTGRES_PASSWORD=<password>
POSTGRES_DB=crib_prod
