# =============================================================================
# Crib — Staging Environment
# Copy to .env.staging
#
# SHARED VALUES — copy directly from geobox-staging's .env:
#   DB_POSTGRES_HOST, DB_POSTGRES_PORT, DB_POSTGRES_USER, DB_POSTGRES_PASSWORD
#   REDIS_HOST, REDIS_PORT, REDIS_PASSWORD
#   LOGTO_ENDPOINT, LOGTO_INTERNAL_URL, LOGTO_ADMIN_ENDPOINT, LOGTO_ADMIN_RESOURCE
#   SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD
#   MINIO_ACCESS_KEY, MINIO_SECRET_KEY
#
# CRIB-SPECIFIC — generate or create fresh:
#   SECRET_KEY, LOGTO_APP_ID, LOGTO_APP_SECRET, LOGTO_M2M_APP_ID,
#   LOGTO_M2M_APP_SECRET, LOGTO_API_RESOURCE, FRONTEND_URL
# =============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=staging
SECRET_KEY=                         # openssl rand -hex 32  (Crib-specific)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=            # required — encrypts payment/SMS keys stored in DB

# ── Shared Postgres — copy from geobox-staging .env ─────────────────────────
DB_POSTGRES_HOST=db
DB_POSTGRES_PORT=5432
DB_POSTGRES_USER=                   # geobox: DB_POSTGRES_USER
DB_POSTGRES_PASSWORD=               # geobox: DB_POSTGRES_PASSWORD
# (DB name is hardcoded to crib_staging in docker-compose.staging.yml)

# ── Shared Redis — copy from geobox-staging .env ─────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                     # geobox: REDIS_PASSWORD
# (Crib uses Redis DBs 8 + 9 — geobox occupies 0-7)

# ── Logto — shared instance ───────────────────────────────────────────────────
# Copy from geobox-staging .env:
LOGTO_ENDPOINT=                     # geobox: LOGTO_ENDPOINT  e.g. https://auth.staging.geoboxafrica.com
LOGTO_PUBLIC_ENDPOINT=              # same as LOGTO_ENDPOINT
LOGTO_INTERNAL_ENDPOINT=            # geobox: LOGTO_INTERNAL_URL  e.g. http://logto:3001
LOGTO_JWKS_URI_OVERRIDE=            # geobox: LOGTO_INTERNAL_URL + /oidc/jwks  e.g. http://logto:3001/oidc/jwks
LOGTO_ADMIN_ENDPOINT=               # geobox: LOGTO_ADMIN_ENDPOINT  e.g. http://logto:3002/
LOGTO_ADMIN_API_RESOURCE=           # geobox: LOGTO_ADMIN_RESOURCE  e.g. https://auth.staging.geoboxafrica.com/api

# Crib-specific Logto apps (create in Logto Admin):
#   Applications → + Add Application → Traditional Web → name "Crib Staging"
LOGTO_APP_ID=                       # Crib-specific — from Logto Admin
LOGTO_APP_SECRET=                   # Crib-specific — from Logto Admin
#   Applications → + Add Application → Machine to Machine → name "Crib Backend Staging"
LOGTO_M2M_APP_ID=                   # Crib-specific — from Logto Admin
LOGTO_M2M_APP_SECRET=               # Crib-specific — from Logto Admin
#   API Resources → + Add API Resource → name "Crib Staging API"
LOGTO_API_RESOURCE=https://api-staging.crib.geoboxafrica.com   # Crib-specific — must match Logto API Resource

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_LOGTO_APP_ID=           # same as LOGTO_APP_ID
FRONTEND_URL=https://staging.crib.geoboxafrica.com
CORS_ORIGINS=https://staging.crib.geoboxafrica.com

# ── MinIO — copy from geobox-staging .env ─────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=                   # geobox: MINIO_ROOT_USER or equivalent
MINIO_SECRET_KEY=                   # geobox: MINIO_ROOT_PASSWORD or equivalent
MINIO_BUCKET=crib-staging
MINIO_SECURE=false

# ── Email — copy from geobox-staging .env ────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=                          # geobox: SMTP_HOST
SMTP_PORT=587                       # geobox: SMTP_PORT
SMTP_USERNAME=                      # geobox: SMTP_USERNAME
SMTP_PASSWORD=                      # geobox: SMTP_PASSWORD
EMAIL_FROM=noreply-staging@crib.geoboxafrica.com
