# =============================================================================
# Crib — Staging Environment
# Copy to .env.staging and fill in values from the shared infrastructure.
# DB_*, REDIS_*, LOGTO_* shared values come from geobox-staging's .env.
# =============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=staging
SECRET_KEY=                     # openssl rand -hex 32

# ── Shared Postgres (container: db on geobox-network) ────────────────────────
DB_HOST=db
DB_PORT=5432
DB_USER=postgres                # same as geobox DB_POSTGRES_USER
DB_PASSWORD=                    # same as geobox DB_POSTGRES_PASSWORD
DB_NAME=crib_staging            # Crib's own database — create with make create-db

# ── Shared Redis (container: redis on geobox-network) ────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                 # same as geobox REDIS_PASSWORD
REDIS_DB=8                      # geobox uses 0-7; Crib app = 8, Celery = 9

# ── Logto — shared instance ───────────────────────────────────────────────────
# Public URL (browser-accessible — used as OIDC issuer in JWT `iss` claim)
LOGTO_ENDPOINT=https://auth.yourdomain.com/
LOGTO_PUBLIC_ENDPOINT=https://auth.yourdomain.com/
# Internal Docker hostname for server-side JWKS fetch
LOGTO_INTERNAL_ENDPOINT=http://logto:3001
LOGTO_JWKS_URI_OVERRIDE=http://logto:3001/oidc/jwks
LOGTO_ADMIN_ENDPOINT=http://logto:3002/
# Crib-specific Logto app (create in Logto Admin → Applications → Traditional Web)
LOGTO_APP_ID=
LOGTO_APP_SECRET=
# Crib M2M app (create in Logto Admin → Applications → Machine to Machine)
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=
# API resource identifier (create in Logto Admin → API Resources)
LOGTO_API_RESOURCE=https://api-staging.crib.yourdomain.com
LOGTO_ADMIN_API_RESOURCE=https://auth.yourdomain.com/api

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_LOGTO_APP_ID=       # same as LOGTO_APP_ID
FRONTEND_URL=https://staging.crib.yourdomain.com
CORS_ORIGINS=https://staging.crib.yourdomain.com

# ── MinIO (shared with geobox) ────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=               # same as geobox MINIO_ACCESS_KEY
MINIO_SECRET_KEY=               # same as geobox MINIO_SECRET_KEY
MINIO_BUCKET=crib-staging
MINIO_SECURE=false

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply-staging@crib.yourdomain.com
