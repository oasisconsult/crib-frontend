# ─── Development environment (shared dev server / CI) ────────────────────────
# Used by: docker-compose.dev.yml
# Store secrets in CI secrets manager, not here.

APP_NAME=Crib
ENVIRONMENT=development

POSTGRES_USER=crib
POSTGRES_PASSWORD=${DEV_POSTGRES_PASSWORD}
POSTGRES_DB=crib_dev

REDIS_PASSWORD=${DEV_REDIS_PASSWORD}

NEXT_PUBLIC_LOGTO_ENDPOINT=https://auth.dev.crib.app
LOGTO_ADMIN_ENDPOINT=https://auth-admin.dev.crib.app
NEXT_PUBLIC_LOGTO_APP_ID=${DEV_LOGTO_APP_ID}
LOGTO_APP_SECRET=${DEV_LOGTO_APP_SECRET}
LOGTO_POSTGRES_USER=logto
LOGTO_POSTGRES_PASSWORD=${DEV_LOGTO_POSTGRES_PASSWORD}
LOGTO_POSTGRES_DB=logto_dev

NEXT_PUBLIC_API_URL=https://api.dev.crib.app
NEXTAUTH_SECRET=${DEV_NEXTAUTH_SECRET}
NEXT_PUBLIC_MSW_ENABLED=false

SECRET_KEY=${DEV_SECRET_KEY}

MINIO_ACCESS_KEY=${DEV_MINIO_ACCESS_KEY}
MINIO_SECRET_KEY=${DEV_MINIO_SECRET_KEY}
MINIO_BUCKET=crib-dev

SENDGRID_API_KEY=${DEV_SENDGRID_API_KEY}
TWILIO_ACCOUNT_SID=${DEV_TWILIO_ACCOUNT_SID}
TWILIO_AUTH_TOKEN=${DEV_TWILIO_AUTH_TOKEN}
TWILIO_FROM_NUMBER=${DEV_TWILIO_FROM_NUMBER}
